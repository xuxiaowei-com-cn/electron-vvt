{
  // TSConfig for the Electron main process.
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["main.ts", "menu.ts", "preload.js", "renderer.js", "updater.ts"],
  "compilerOptions": {
    // Electron main process may also touch DOM-related APIs (e.g. via preload).
    "lib": ["ES2024", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo"
  }
}
